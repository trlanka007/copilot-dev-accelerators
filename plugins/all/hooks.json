{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ${PLUGIN_ROOT}/hooks/guard-main-commit.ps1",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ${PLUGIN_ROOT}\\hooks\\guard-main-commit.ps1",
        "timeout": 15
      }
    ]
  }
}
